# Copy to .env.local (or set in Vercel → Settings → Environment Variables).
# Only VITE_-prefixed values reach the browser. These two are PUBLIC by design
# (Supabase protects data with row-level security). NEVER put the service-role
# key or the Razorpay secret here — those go in `supabase secrets set`.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public site URL, used for structured data.
VITE_SITE_URL=
