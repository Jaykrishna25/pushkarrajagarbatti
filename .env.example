# Copy to .env.local and fill in. Only VITE_-prefixed values reach the browser,
# so NEVER put a secret key here — secrets belong on the checkout server.

# Public URL of YOUR checkout server endpoint (see README → Checkout).
# Leave empty and the cart will say online checkout isn't connected yet.
VITE_CHECKOUT_ENDPOINT=

# Public site URL, used for canonical/OG tags at deploy time.
VITE_SITE_URL=
